{
  "name": "drift-next",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter console dev",
    "build": "pnpm --filter console build",
    "typecheck": "pnpm --filter console typecheck",
    "lint": "pnpm --filter console lint",
    "test": "pnpm --filter console test",
    "tauri": "pnpm --filter console tauri",
    "runtime": "go run ./cmd/drift",
    "go:test": "go test ./...",
    "go:migrations": "go test ./internal/platform/migrations ./db/migrations -count=1",
    "go:vet": "go vet ./...",
    "go:build": "go build ./...",
    "security:scan": "bash scripts/secret-scan.sh",
    "check:diff": "git diff --check",
    "contracts:format:check": "buf format --diff --exit-code",
    "contracts:lint": "buf lint",
    "contracts:build": "buf build",
    "contracts:generate": "buf generate && bash scripts/normalize-generated-typescript.sh",
    "contracts:generate:check": "bash scripts/check-generated.sh",
    "infra:config": "docker compose -f deploy/compose/docker-compose.yml config --quiet"
  }
}
